    <!-- Initialize AOS and PureCounter -->
    <script>
      AOS.init({
        duration: 600,
        easing: 'ease-in-out',
        once: true,
        mirror: false,
        offset: -200
      });
      new PureCounter();
    </script>

    <!-- Scripts -->
    <script src="assets/js/preloader.js"></script>
    <script src="assets/js/menu.js"></script>
    <script src="assets/js/search-data.js"></script>
    <script src="assets/js/search.js"></script>
    <script src="assets/js/faq.js"></script>
    <script src="assets/js/circular-nav.js"></script>

    <!-- Navbar Scroll Animation -->
    <script>
      let hasScrolled = false;
      const mobileMediaQuery = window.matchMedia('(max-width: 767px)');
      let iconsOriginalParent = null;
      let iconsOriginalNextSibling = null;

      function forceDesktopTopTransparent(navbar) {
        if (!navbar || mobileMediaQuery.matches) return;
        if (window.scrollY > 10) return;

        navbar.style.setProperty('background-color', 'transparent', 'important');
        navbar.style.setProperty('background-image', 'none', 'important');
        navbar.style.setProperty('backdrop-filter', 'none', 'important');
        navbar.style.setProperty('-webkit-backdrop-filter', 'none', 'important');
        navbar.style.setProperty('box-shadow', 'none', 'important');
        navbar.classList.remove('backdrop');
        navbar.classList.remove('shadow-transition');
      }

      function applyMobileNavbar() {
        const navbar = document.getElementById('mainNavbar');
        const brand = document.getElementById('cosmicBrand');
        const brandText = brand ? brand.querySelector('.fw-bold') : null;
        const tagline = document.getElementById('tagline');
        const navContainer = navbar ? navbar.querySelector('.container') : null;
        const iconsBar = document.querySelector('.navbar-icons-bar');
        const iconButtons = iconsBar ? iconsBar.querySelectorAll('a, button') : [];
        const isSmallMobile = window.innerWidth <= 575;

        hasScrolled = false;
        if (!navbar || !brand || !tagline || !brandText) return;

        // Mobile: static compact navbar, no scroll animation states.
        navbar.style.paddingTop = '0.75rem';
        navbar.style.paddingBottom = '0.75rem';
        brand.style.fontSize = 'clamp(0.7rem, 3vw, 0.9rem)';
        brand.style.letterSpacing = '0.07em';
        brand.style.whiteSpace = 'nowrap';
        brand.style.maxWidth = isSmallMobile ? 'calc(100vw - 165px)' : 'calc(100vw - 180px)';
        brand.style.overflow = 'hidden';
        brand.style.textOverflow = 'ellipsis';
        brand.style.flex = '0 1 auto';
        brandText.style.color = '#000';
        brandText.style.textShadow = 'none';
        tagline.style.display = 'none';
        navbar.style.setProperty('background-color', 'rgba(255, 255, 255, 0.12)', 'important');
        navbar.style.setProperty('background-image', 'none', 'important');
        navbar.style.setProperty('backdrop-filter', 'blur(22px) saturate(180%)', 'important');
        navbar.style.setProperty('-webkit-backdrop-filter', 'blur(22px) saturate(180%)', 'important');
        navbar.style.setProperty('box-shadow', '0 2px 16px rgba(0, 0, 0, 0.06)', 'important');
        navbar.classList.remove('backdrop');
        navbar.classList.remove('shadow-transition');

        if (navContainer) {
          navContainer.style.setProperty('display', 'flex', 'important');
          navContainer.style.setProperty('flex-direction', 'row', 'important');
          navContainer.style.setProperty('justify-content', 'space-between', 'important');
          navContainer.style.setProperty('align-items', 'center', 'important');
          navContainer.style.setProperty('padding-left', isSmallMobile ? '0.75rem' : '1rem', 'important');
          navContainer.style.setProperty('padding-right', isSmallMobile ? '0.75rem' : '1rem', 'important');
          navContainer.style.minHeight = '56px';
        }

        if (iconsBar) {
          if (!iconsOriginalParent) {
            iconsOriginalParent = iconsBar.parentElement;
            iconsOriginalNextSibling = iconsBar.nextElementSibling;
          }

          if (navContainer && iconsBar.parentElement !== navContainer) {
            navContainer.appendChild(iconsBar);
          }

          iconsBar.style.setProperty('position', 'static', 'important');
          iconsBar.style.setProperty('top', '0.75rem', 'important');
          iconsBar.style.setProperty('right', 'auto', 'important');
          iconsBar.style.setProperty('left', 'auto', 'important');
          iconsBar.style.setProperty('gap', isSmallMobile ? '0.35rem' : '0.5rem', 'important');
          iconsBar.style.setProperty('margin-left', '0', 'important');
          iconsBar.style.setProperty('display', 'flex', 'important');
          iconsBar.style.setProperty('flex-wrap', 'nowrap', 'important');
          iconsBar.style.setProperty('flex-shrink', '0', 'important');
          iconsBar.style.setProperty('align-items', 'center', 'important');
          iconsBar.style.setProperty('justify-content', 'flex-end', 'important');
          iconsBar.style.setProperty('min-width', isSmallMobile ? '72px' : '80px', 'important');
          iconsBar.style.setProperty('z-index', '10000', 'important');
          iconsBar.style.removeProperty('max-width');
        }

        iconButtons.forEach(function(el) {
          el.style.width = isSmallMobile ? '20px' : '22px';
          el.style.height = isSmallMobile ? '20px' : '22px';
          el.style.padding = '0';
          el.style.margin = '0';
          el.style.display = 'inline-flex';
          el.style.alignItems = 'center';
          el.style.justifyContent = 'center';
          el.style.flex = '0 0 auto';
          el.style.lineHeight = '1';

          const iconSvg = el.querySelector('svg');
          if (iconSvg) {
            iconSvg.style.width = isSmallMobile ? '18px' : '20px';
            iconSvg.style.height = isSmallMobile ? '18px' : '20px';
          }
        });
      }

      function handleDesktopNavbarScroll() {
        const navbar = document.getElementById('mainNavbar');
        const brand = document.getElementById('cosmicBrand');
        const brandText = brand ? brand.querySelector('.fw-bold') : null;
        const tagline = document.getElementById('tagline');
        const cardsSection = document.getElementById('header');
        const navContainer = navbar ? navbar.querySelector('.container') : null;
        const iconsBar = document.querySelector('.navbar-icons-bar');
        const iconButtons = iconsBar ? iconsBar.querySelectorAll('a, button') : [];

        if (!navbar || !brand || !tagline || !brandText) return;

        if (mobileMediaQuery.matches) {
          applyMobileNavbar();
          return;
        }

        if (navContainer) {
          navContainer.style.removeProperty('display');
          navContainer.style.removeProperty('flex-direction');
          navContainer.style.removeProperty('justify-content');
          navContainer.style.removeProperty('align-items');
          navContainer.style.removeProperty('padding-left');
          navContainer.style.removeProperty('padding-right');
          navContainer.style.removeProperty('min-height');
        }

        brand.style.removeProperty('letter-spacing');
        brand.style.removeProperty('white-space');
        brand.style.removeProperty('max-width');
        brand.style.removeProperty('overflow');
        brand.style.removeProperty('text-overflow');
        brand.style.removeProperty('flex');

        if (iconsBar) {
          if (iconsOriginalParent && iconsBar.parentElement !== iconsOriginalParent) {
            if (iconsOriginalNextSibling && iconsOriginalNextSibling.parentElement === iconsOriginalParent) {
              iconsOriginalParent.insertBefore(iconsBar, iconsOriginalNextSibling);
            } else {
              iconsOriginalParent.appendChild(iconsBar);
            }
          }

          iconsBar.style.setProperty('position', 'fixed', 'important');
          iconsBar.style.setProperty('top', '1.5rem', 'important');
          iconsBar.style.setProperty('right', '2rem', 'important');
          iconsBar.style.setProperty('left', 'auto', 'important');
          iconsBar.style.setProperty('gap', '1.5rem', 'important');
          iconsBar.style.removeProperty('margin-left');
          iconsBar.style.removeProperty('display');
          iconsBar.style.removeProperty('flex-wrap');
          iconsBar.style.removeProperty('flex-shrink');
          iconsBar.style.removeProperty('align-items');
          iconsBar.style.removeProperty('justify-content');
          iconsBar.style.removeProperty('min-width');
          iconsBar.style.removeProperty('max-width');
        }

        iconButtons.forEach(function(el) {
          el.style.removeProperty('width');
          el.style.removeProperty('height');
          el.style.removeProperty('padding');
          el.style.removeProperty('margin');
          el.style.removeProperty('display');
          el.style.removeProperty('align-items');
          el.style.removeProperty('justify-content');
          el.style.removeProperty('flex');
          el.style.removeProperty('line-height');

          const iconSvg = el.querySelector('svg');
          if (iconSvg) {
            iconSvg.style.removeProperty('width');
            iconSvg.style.removeProperty('height');
          }
        });
        
        if (window.scrollY > 10 && !hasScrolled) {
          hasScrolled = true;
          // Shrink to normal size
          navbar.style.paddingTop = '1rem';
          navbar.style.paddingBottom = '1rem';
          brand.style.fontSize = '1.5rem';
          navbar.style.setProperty('background-color', 'rgba(255, 255, 255, 0.12)', 'important');
          navbar.style.setProperty('background-image', 'none', 'important');
          navbar.style.setProperty('backdrop-filter', 'blur(22px) saturate(180%)', 'important');
          navbar.style.setProperty('-webkit-backdrop-filter', 'blur(22px) saturate(180%)', 'important');
          navbar.style.setProperty('box-shadow', '0 2px 16px rgba(0, 0, 0, 0.06)', 'important');
          navbar.classList.add('backdrop');
          navbar.classList.add('shadow-transition');
          // Change text color to black and remove 3D effect
          brandText.style.color = '#000';
          brandText.style.textShadow = 'none';
          // Hide tagline completely (remove from layout)
          tagline.style.display = 'none';
          // Move cards section up to fill the space
          if (cardsSection) {
            cardsSection.style.marginTop = '-23rem';
          }
        } else if (window.scrollY <= 10 && hasScrolled) {
          hasScrolled = false;
          // Return to large size
          navbar.style.paddingTop = '16rem';
          navbar.style.paddingBottom = '3rem';
          brand.style.fontSize = '7rem';
          forceDesktopTopTransparent(navbar);
          // Change text color to white and remove shadow
          brandText.style.color = '#fff';
          brandText.style.textShadow = 'none';
          // Show tagline
          tagline.style.display = 'block';
          // Return cards section to original position
          if (cardsSection) {
            cardsSection.style.marginTop = '-5rem';
          }
        }
        
        // Always force transparent background when at top
        if (window.scrollY <= 10) {
          forceDesktopTopTransparent(navbar);

          // Re-apply at end-of-frame so index-specific top state wins over shared handlers.
          requestAnimationFrame(function() {
            forceDesktopTopTransparent(navbar);
          });
        }
      }

      window.addEventListener('scroll', handleDesktopNavbarScroll);

      window.addEventListener('resize', function() {
        if (mobileMediaQuery.matches) {
          applyMobileNavbar();
        } else {
          handleDesktopNavbarScroll();
        }
      });

      if (mobileMediaQuery.matches) {
        applyMobileNavbar();
      } else {
        handleDesktopNavbarScroll();
      }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet">

    <!-- Auto-Rotating Carousel Script -->
    <script>
      function initAutoCarousel(carouselId, interval = 3000) {
        const carousel = document.getElementById(carouselId);
        if (!carousel) return;

        const images = carousel.querySelectorAll('.carousel-image');
        if (images.length === 0) return;

        let currentIndex = 0;

        function showImage(index) {
          images.forEach((img, i) => {
            img.style.opacity = i === index ? '1' : '0';
          });
        }

        function nextImage() {
          currentIndex = (currentIndex + 1) % images.length;
          showImage(currentIndex);
        }

        // Start auto-rotation
        setInterval(nextImage, interval);
      }

      // Initialize both carousels
      document.addEventListener('DOMContentLoaded', function() {
        initAutoCarousel('natural-stone-carousel', 3000);
        initAutoCarousel('tiles-carousel', 3000);
      });
    </script>
  </body>

</html>

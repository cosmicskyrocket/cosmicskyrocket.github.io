      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://www.cosmicskyrocket.com/#organization",
            "name": "Cosmic Skyrocket",
            "url": "https://www.cosmicskyrocket.com/",
            "description": "Quarry owner and manufacturer of natural stones and tiles for B2B projects and exports.",
            "logo": "https://www.cosmicskyrocket.com/assets/img/favicon_io/android-chrome-512x512.png"
          },
          {
            "@type": "WebSite",
            "@id": "https://www.cosmicskyrocket.com/#website",
            "url": "https://www.cosmicskyrocket.com/",
            "name": "Cosmic Skyrocket",
            "publisher": {
              <!-- amCharts Map Script -->
              <script src="https://cdn.amcharts.com/lib/editor/map/5/viewer.js"></script>
              <script src="assets/js/world-map-config.js"></script>
              <script>
                (function () {
                  function hideMapCornerControls() {
                    const chartDiv = document.getElementById("chartdiv");
                    if (!chartDiv) return;

                    const styleId = "map-ui-hide-style";
                    if (!document.getElementById(styleId)) {
                      const style = document.createElement("style");
                      style.id = styleId;
                      style.textContent = [
                        "#chartdiv a[href*='amcharts.com'] { display: none !important; }",
                        "#chartdiv [title*='amCharts'], #chartdiv [aria-label*='amCharts'] { display: none !important; }",
                        "#chartdiv [title*='Download'], #chartdiv [aria-label*='Download'] { display: none !important; }",
                        "#chartdiv [title*='More'], #chartdiv [aria-label*='More'] { display: none !important; }",
                        "#chartdiv [title*='Zoom'], #chartdiv [aria-label*='Zoom'] { display: none !important; }",
                        "#chartdiv .am5exporting-menu, #chartdiv .am5zoomcontrol { display: none !important; }"
                      ].join("\n");
                      document.head.appendChild(style);
                    }

                    const hideDynamicNodes = function () {
                      const nodes = chartDiv.querySelectorAll("a, button, div, span");
                      nodes.forEach(function (node) {
                        const marker = (
                          (node.getAttribute("title") || "") + " " +
                          (node.getAttribute("aria-label") || "") + " " +
                          (node.textContent || "")
                        ).toLowerCase();

                        if (/amcharts|download|zoom|more/.test(marker)) {
                          node.style.display = "none";
                          node.style.visibility = "hidden";
                          node.style.pointerEvents = "none";
                        }
                      });
                    };

                    hideDynamicNodes();
                    const observer = new MutationObserver(hideDynamicNodes);
                    observer.observe(chartDiv, { childList: true, subtree: true });
                  }

                  const mapConfig = window.WORLD_MAP_CONFIG
                    ? JSON.parse(JSON.stringify(window.WORLD_MAP_CONFIG))
                    : null;

                  if (!mapConfig) return;

                  const editorMap = mapConfig.settings && mapConfig.settings["editor.map"];
                  if (editorMap) {
                    editorMap.panX = "none";
                    editorMap.panY = "none";
                    editorMap.wheelX = "none";
                    editorMap.wheelY = "none";
                    editorMap.pinchZoom = false;
                    editorMap.wheelable = false;

                    if (editorMap.zoomControl && editorMap.zoomControl.settings) {
                      editorMap.zoomControl.settings.visible = false;
                    }
                  }

                  am5viewer.create("chartdiv", mapConfig);
                  hideMapCornerControls();
                })();
              </script>
                  "value": "#323232"
                }
              }
            }

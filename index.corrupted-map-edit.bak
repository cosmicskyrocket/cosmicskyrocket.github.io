    <meta property="og:type" content="website">
    <meta property="og:title" content="Cosmic Skyrocket | Quarry Owner & Manufacturer of Natural Stones and Tiles">
    <meta property="og:description" content="B2B Natural Stones and tile manufacturing from owned quarries, with export-ready packaging and project-scale supply.">
    <meta property="og:url" content="https://www.cosmicskyrocket.com/">
